# Public URL of the site, base path included. Used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://noveo.fr

# Sub-path the site is served from, e.g. /novily on a GitHub Pages project site. Empty on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Formspree form that receives the contact form. Empty: the site's form, https://formspree.io/f/mpppakvq.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty: no analytics, no cookie banner.
# Analytics only loads after the visitor accepts in the consent banner.
NEXT_PUBLIC_GA_ID=

# Public URL of the site, base path included. Used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://novily.fr

# Sub-path the site is served from, e.g. /novily on a GitHub Pages project site. Empty on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Form service that receives the contact form as JSON (e.g. https://formspree.io/f/xxxxxxx).
# Empty: the form opens the visitor's e-mail app with the message filled in.
NEXT_PUBLIC_CONTACT_ENDPOINT=
